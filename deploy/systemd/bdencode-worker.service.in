[Unit]
Description=BDEncode single-job worker
Requires=bdencode-update-recovery.service
After=network-online.target bdencode-update-recovery.service bdencode-api.service
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=@USER@
Group=@GROUP@
WorkingDirectory=@DATA_ROOT@
Environment=BDENCODE_CONFIG=/etc/bdencode/config.toml
Environment=BDENCODE_USER=@USER@
Environment=BDENCODE_DATA_ROOT=@DATA_ROOT@
Environment=XDG_CACHE_HOME=@DATA_ROOT@/cache
Environment=XDG_CONFIG_HOME=@APP_ROOT@/tools/current/config
Environment=PATH=@APP_ROOT@/tools/current/bin:@APP_ROOT@/current/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@APP_ROOT@/current/venv/bin/bdencode worker
Restart=on-failure
RestartSec=10s
TimeoutStartSec=120s
TimeoutStopSec=300s
KillMode=control-group
KillSignal=SIGINT
UMask=0027
# Image host keys changed on the System page while the worker runs: the root
# helper writes them here (tmpfs, removed when the worker stops) and every
# upload reads them before the credentials loaded at start.
RuntimeDirectory=bdencode-worker
RuntimeDirectoryMode=0700
Environment=BDENCODE_LIVE_CREDENTIAL_DIR=/run/bdencode-worker/credentials
Nice=10
CPUAccounting=true
CPUQuota=@CPU_QUOTA@
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
# A GPU is optional. install.sh binds the GPU devices this host has (the WSL
# GPU or the NVIDIA driver's nodes) in bdencode-worker.service.d/gpu.conf;
# without one the crop scan decodes on the CPU.
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=@DATA_ROOT@/state @DATA_ROOT@/jobs @DATA_ROOT@/completed @DATA_ROOT@/release-kits @DATA_ROOT@/cache @DATA_ROOT@/updates
ReadOnlyPaths="@SOURCE_ROOT@"

[Install]
WantedBy=multi-user.target
