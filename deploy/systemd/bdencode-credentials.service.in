[Unit]
Description=Store the API keys that the BDEncode web UI submits

[Service]
Type=oneshot
User=root
Group=root
Environment=BDENCODE_USER=@USER@
Environment=BDENCODE_CREDENTIAL_DIR=@CREDENTIAL_DIR@
Environment=BDENCODE_CREDENTIAL_REQUEST_DIR=/run/bdencode-api
ExecStart=/usr/local/libexec/bdencode-credentials process
# The helper deletes the API's request files, encrypts the key into the
# operator's credential directory and rewrites the consumer's credential
# drop-in.  An AI key restarts the API; an image host key is also handed to
# the running worker in /run/bdencode-worker (tmpfs) without a restart.  It
# needs no network and writes nowhere else.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=@CREDENTIAL_DIR@ /etc/systemd/system/bdencode-api.service.d -/etc/systemd/system/bdencode-worker.service.d
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
