[Unit]
Description=Store the AI provider API keys that the BDEncode web UI submits

[Service]
Type=oneshot
User=root
Group=root
Environment=BDENCODE_USER=@USER@
Environment=BDENCODE_CREDENTIAL_DIR=@CREDENTIAL_DIR@
Environment=BDENCODE_CREDENTIAL_REQUEST_DIR=/run/bdencode-api
ExecStart=/usr/local/libexec/bdencode-credentials process
# The helper deletes the API's request files, encrypts the key into the
# operator's credential directory, rewrites the API's credential drop-in and
# restarts the API.  It needs no network and writes nowhere else.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=@CREDENTIAL_DIR@ /etc/systemd/system/bdencode-api.service.d
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
