[Unit]
Description=Start the BDEncode worker when a passing condition left it stopped

[Service]
Type=oneshot
User=root
Group=root
# See the comments of the helper: it starts only a plainly stopped, enabled
# worker and leaves everything alone while an update or installer runs.
ExecStart=/usr/local/libexec/bdencode-worker-ensure
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
